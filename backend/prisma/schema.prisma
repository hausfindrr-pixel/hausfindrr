generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  landlord
  tenant
  admin
}

enum UserStatus {
  pending_verification
  active
  rejected
  suspended
}

enum IdDocType {
  passport
  drivers_licence
  nid
}

enum TitleDocType {
  title
  other
}

enum ListingType {
  rent
  sale
}

enum PropertyType {
  house
  apartment
}

enum PropertyStatus {
  draft
  pending
  active
  rejected
  rented
}


model User {
  id            String     @id @default(uuid())
  role          UserRole
  name          String
  email         String     @unique
  phone         String
  passwordHash  String?    @map("password_hash")
  googleId      String?    @unique @map("google_id")
  status        UserStatus @default(pending_verification)
  termsAccepted   Boolean   @default(false) @map("terms_accepted")
  termsAcceptedAt DateTime? @map("terms_accepted_at")
  termsAcceptedIp String?   @map("terms_accepted_ip")
  termsVersion    String?   @map("terms_version")
  twoFactorSecret     String?  @map("two_factor_secret")
  twoFactorEnabled    Boolean  @default(false) @map("two_factor_enabled")
  twoFactorBackupHash String?  @map("two_factor_backup_hash")
  accountCode   String?    @unique @map("account_code")
  createdAt     DateTime   @default(now()) @map("created_at")

  landlordIdDocuments  LandlordIdDocument[]
  properties           Property[]
  favorites            Favorite[]
  sentMessages         Message[]      @relation("SentMessages")
  receivedMessages     Message[]      @relation("ReceivedMessages")
  sentAnnouncements    Announcement[] @relation("SentAnnouncements")
  tenantComplaints     Complaint[]    @relation("TenantComplaints")
  landlordComplaints   Complaint[]    @relation("LandlordComplaints")
  notifications        UserNotification[]
  consentLogs          ConsentLog[]
  dataRequests         DataRequest[]
  propertyViewLogs     PropertyViewLog[]

  @@index([role, status])
  @@index([createdAt])
  @@map("users")
}

model LandlordIdDocument {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  docType     IdDocType @map("doc_type")
  filePath    String    @map("file_path")
  publicId    String?   @map("public_id")
  uploadedAt  DateTime  @default(now()) @map("uploaded_at")
  expiresAt   DateTime  @map("expires_at")
  legalHold   Boolean   @default(false) @map("legal_hold")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("landlord_id_documents")
}

model PropertyTitleDocument {
  id          String       @id @default(uuid())
  propertyId  String       @map("property_id")
  docType     TitleDocType @map("doc_type")
  filePath    String       @map("file_path")
  publicId    String?      @map("public_id")
  uploadedAt  DateTime     @default(now()) @map("uploaded_at")
  expiresAt   DateTime     @map("expires_at")
  legalHold   Boolean      @default(false) @map("legal_hold")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_title_documents")
}

model Property {
  id              String         @id @default(uuid())
  landlordId      String         @map("landlord_id")
  listingType     ListingType    @map("listing_type")
  title           String
  description     String
  price           Decimal        @db.Decimal(12, 2)
  locationGeneral String         @map("location_general")
  locationExact   String         @map("location_exact")
  locationLat     Float?         @map("location_lat")
  locationLng     Float?         @map("location_lng")
  bedrooms        Int?
  bathrooms       Int?
  propertyType    PropertyType   @map("property_type")
  rentFrequency   String?        @map("rent_frequency")
  metadata        Json?
  occupied        Boolean        @default(false)
  sold            Boolean        @default(false)
  status          PropertyStatus @default(pending)
  rejectionReason String?        @map("rejection_reason")
  createdAt       DateTime       @default(now()) @map("created_at")

  landlord       User                    @relation(fields: [landlordId], references: [id], onDelete: Cascade)
  photos         PropertyPhoto[]
  amenities      Amenity[]
  titleDocuments PropertyTitleDocument[]
  favorites      Favorite[]
  messages       Message[]
  complaints     Complaint[]
  viewLogs       PropertyViewLog[]
  viewSummaries  PropertyViewSummary[]

  @@index([status])
  @@index([landlordId])
  @@index([createdAt])
  @@map("properties")
}

model PropertyPhoto {
  id         String   @id @default(uuid())
  propertyId String   @map("property_id")
  filePath   String   @map("file_path")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_photos")
}

model Amenity {
  id          String @id @default(uuid())
  propertyId  String @map("property_id")
  amenityName String @map("amenity_name")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("amenities")
}


model Favorite {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  propertyId String   @map("property_id")
  savedAt    DateTime @default(now()) @map("saved_at")

  tenant   User     @relation(fields: [tenantId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])

  @@unique([tenantId, propertyId])
  @@map("favorites")
}

model Message {
  id         String    @id @default(uuid())
  propertyId String?   @map("property_id")
  senderId   String    @map("sender_id")
  receiverId String    @map("receiver_id")
  content    String
  sentAt     DateTime  @default(now()) @map("sent_at")
  readAt     DateTime? @map("read_at")

  property Property? @relation(fields: [propertyId], references: [id])
  sender   User      @relation("SentMessages", fields: [senderId], references: [id])
  receiver User      @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@index([propertyId])
  @@index([senderId])
  @@index([receiverId])
  @@index([sentAt])
  @@map("messages")
}

model Announcement {
  id         String   @id @default(uuid())
  senderId   String   @map("sender_id")
  targetRole String   @map("target_role")
  content    String
  createdAt  DateTime @default(now()) @map("created_at")

  sender User @relation("SentAnnouncements", fields: [senderId], references: [id])

  @@index([targetRole])
  @@index([createdAt])
  @@map("announcements")
}

model Complaint {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  landlordId String?  @map("landlord_id")
  propertyId String?  @map("property_id")
  type       String
  details    String?
  context    String   @default("landlord") @map("context")
  status     String   @default("new")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   User      @relation("TenantComplaints", fields: [tenantId], references: [id])
  landlord User?     @relation("LandlordComplaints", fields: [landlordId], references: [id])
  property Property? @relation(fields: [propertyId], references: [id])

  @@index([status])
  @@index([tenantId])
  @@index([createdAt])
  @@map("complaints")
}

model UserNotification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String
  title     String
  content   String
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("user_notifications")
}

// Immutable consent audit log — one row per acceptance event, never updated.
// userId is nullable so rows survive account deletion.
model ConsentLog {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  userEmail   String   @map("user_email")
  userRole    String   @map("user_role")
  document    String   // e.g. "terms_of_service", "privacy_policy", "landlord_agreement", "tenant_safety"
  version     String   // e.g. "v1.0-july2026"
  accepted    Boolean  @default(true)
  acceptedAt  DateTime @default(now()) @map("accepted_at")
  ipAddress   String   @map("ip_address")
  userAgent   String   @map("user_agent")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userEmail])
  @@index([document])
  @@index([acceptedAt])
  @@map("consent_logs")
}

model DataRequest {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  userEmail String   @map("user_email")
  type      String   // "export" | "deletion"
  status    String   @default("pending") // "pending" | "completed"
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
  @@map("data_requests")
}

// One row per (property, date, viewer) — deduplicated to count unique viewers per day.
// viewerId null = anonymous; anonHash = hash(salt+ip+ua+propertyId+date).
model PropertyViewLog {
  id         String   @id @default(uuid())
  propertyId String   @map("property_id")
  viewedOn   DateTime @map("viewed_on") @db.Date
  viewerId   String?  @map("viewer_id")
  anonHash   String?  @map("anon_hash")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  viewer   User?    @relation(fields: [viewerId], references: [id], onDelete: SetNull)

  @@unique([propertyId, viewedOn, viewerId], name: "uniq_auth_view")
  @@unique([propertyId, viewedOn, anonHash], name: "uniq_anon_view")
  @@index([propertyId])
  @@index([viewedOn])
  @@map("property_view_logs")
}

// Funnel event counter — no PII, no cookies.
model FunnelEvent {
  id         String   @id @default(uuid())
  event      String   // page_opened | account_created | listing_started | listing_submitted | id_uploaded
  campaign   String?  // utm_campaign value, null = direct
  happenedAt DateTime @default(now()) @map("happened_at")

  @@index([event])
  @@index([campaign])
  @@index([happenedAt])
  @@map("funnel_events")
}

// Daily unique-viewer summary per property — pre-aggregated for fast stats queries.
model PropertyViewSummary {
  id           String   @id @default(uuid())
  propertyId   String   @map("property_id")
  summaryDate  DateTime @map("summary_date") @db.Date
  uniqueViews  Int      @default(0) @map("unique_views")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, summaryDate])
  @@index([propertyId])
  @@index([summaryDate])
  @@map("property_view_summaries")
}
